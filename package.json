{
  "name": "dsh-reasoning-level-slider",
  "version": "1.0.1",
  "type": "module",
  "description": "Adds a reasoning-effort slider to the composer model menu so one drag switches the current model's reasoning level.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peter9130/dsh-reasoning-level-slider.git"
  },
  "homepage": "https://github.com/peter9130/dsh-reasoning-level-slider#readme",
  "bugs": {
    "url": "https://github.com/peter9130/dsh-reasoning-level-slider/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "reasoning",
    "model-menu",
    "web-ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
